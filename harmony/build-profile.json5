{
  "app": {
    "signingConfigs": [],
    // 与 Tydora-HMOS（已验证可产出可安装 hap）保持一致的 SDK 设定：
    //   - runtimeOS: OpenHarmony —— 对应 local.properties 里的
    //     sdk.dir=/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony
    //   - compileSdkVersion 20 / compatibleSdkVersion "6.0.0(20)"
    //     signing/sign.sh 里 hap-sign-tool 的 -compatibleVersion 必须同为 20。
    "products": [
      {
        "name": "default",
        "signingConfig": "",
        "compileSdkVersion": 20,
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "OpenHarmony",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyToProducts": ["default"] }
      ]
    }
  ]
}
