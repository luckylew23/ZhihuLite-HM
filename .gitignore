.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
/build

# HarmonyOS (HMOS) build artifacts
/oh_modules/
/.hvigor/
harmony/oh_modules/
harmony/**/oh_modules/
harmony/entry/build/
harmony/build/
harmony/.hvigor/
harmony/**/node_modules/
harmony/codecache/
# JS bundle + 资源由 scripts/build-ohos-bundle.js 生成，属构建产物
harmony/entry/src/main/resources/rawfile/
# HarmonyOS NEXT 原生工程（harmony-native）构建产物
harmony-native/.hvigor/
harmony-native/oh_modules/
harmony-native/**/oh_modules/
harmony-native/entry/build/
harmony-native/build/
harmony-native/.cxx/
harmony-native/codecache/
harmony-native/.clangd/
harmony-native/.clang-format
ohos-bundle/
*.hap
*.hsp
*.har

# 签名：仓库只保留脚本与公开证书，私钥(p12)/profile(p7b) 本地保存
harmony/signing/*.p7b
harmony/signing/verify-*

# 本地备份目录
.hmos-backup/
